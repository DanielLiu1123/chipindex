# Supabase (server-side only, never exposed to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Shared group password
SHARED_PASSWORD=your-group-password

# Fixed UTC rollout instant for sessions already live when Event Log is enabled.
# Set once on rollout and keep across deployments. With no value, only sessions
# whose opening roster shares the start timestamp show events.
SESSION_EVENT_LOG_FROM=
